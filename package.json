{
  "name": "@tscircuit/length-matching-post-process",
  "version": "0.0.1",
  "description": "Differential-pair length-matching post-processing for Simple Route JSON",
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.ts",
  "module": "./lib/index.ts",
  "types": "./lib/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.ts",
      "import": "./lib/index.ts"
    }
  },
  "files": [
    "dist",
    "lib",
    "README.md",
    "FEATURES.md"
  ],
  "scripts": {
    "start": "cosmos",
    "build": "tsup lib/index.ts --format esm --dts --sourcemap --clean",
    "prepublishOnly": "bun run build",
    "build:playground": "vite build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "cosmos:export": "cosmos-export",
    "vercel-build": "cosmos-export"
  },
  "dependencies": {
    "@tscircuit/capacity-autorouter": "^0.0.710"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.2.23",
    "@types/react": "18",
    "@types/react-dom": "18",
    "@vitejs/plugin-react": "4",
    "react": "18",
    "react-cosmos": "6.2.3",
    "react-cosmos-plugin-vite": "6.2.0",
    "react-dom": "18",
    "tsup": "^8.3.6",
    "typescript": "^5.9.3",
    "vite": "6",
    "vite-tsconfig-paths": "5"
  }
}
